# Copy this file to game/.env.local and fill it in. These four values are public, not secrets.
# Firebase console > Project settings > Your apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
# Same place in the console (authDomain).
VITE_FIREBASE_AUTH_DOMAIN=
# Same place in the console (projectId).
VITE_FIREBASE_PROJECT_ID=
# Same place in the console (appId).
VITE_FIREBASE_APP_ID=
# The absolute path to the Firebase service-account JSON, outside every checkout, never committed (dev server and set_role.mjs).
# SBA_FIREBASE_ADMIN_KEY=
# Optional: the Realtime Database URL when it is not https://<project id>-default-rtdb.firebaseio.com.
# SBA_FIREBASE_DATABASE_URL=
