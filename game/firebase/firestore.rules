// FEAT-273: everything is denied to clients. The Admin SDK (tools/set_role.mjs, the dev server) bypasses these
// rules. FEAT-205 opens reads of players/<uid> when the game first reads it.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
